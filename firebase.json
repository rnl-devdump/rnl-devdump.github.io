{
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "target": "portal",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "firestore.rules",
        "database.rules.json",
        "**/.*",
        "**/node_modules/**",
        "src/**",
        "scripts/**",
        "tests/**",
        "vite*.config.js",
        "package*.json",
        "requirements.txt",
        "*.mjs"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
          ]
        }
      ],
      "redirects": [
        { "source": "/dashboard", "destination": "https://console.kiruu.xyz/", "type": 301 },
        { "source": "/dashboard/:path*", "destination": "https://console.kiruu.xyz/:path", "type": 301 },
        { "source": "/tawir-convo", "destination": "https://console.kiruu.xyz/#conversations", "type": 301 },
        { "source": "/tawir-convo/:path*", "destination": "https://console.kiruu.xyz/#conversations", "type": 301 },
        { "source": "/tawir-beta", "destination": "https://tawir.kiruu.xyz/beta/", "type": 301 },
        { "source": "/tawir-beta/:path*", "destination": "https://tawir.kiruu.xyz/beta/:path", "type": 301 },
        { "source": "/tawir-dev", "destination": "https://tawir.kiruu.xyz/beta/", "type": 301 },
        { "source": "/tawir-dev/:path*", "destination": "https://tawir.kiruu.xyz/beta/:path", "type": 301 },
        { "source": "/tawir", "destination": "https://tawir.kiruu.xyz/", "type": 301 },
        { "source": "/tawir/:path*", "destination": "https://tawir.kiruu.xyz/:path", "type": 301 },
        { "source": "/vl-assist", "destination": "https://vl-assist.kiruu.xyz/", "type": 301 },
        { "source": "/vl-assist/:path*", "destination": "https://vl-assist.kiruu.xyz/:path", "type": 301 },
        { "source": "/anvil", "destination": "https://anvil.kiruu.xyz/", "type": 301 },
        { "source": "/anvil/:path*", "destination": "https://anvil.kiruu.xyz/:path", "type": 301 },
        { "source": "/studybuddy", "destination": "https://anvil.kiruu.xyz/", "type": 301 },
        { "source": "/studybuddy/:path*", "destination": "https://anvil.kiruu.xyz/:path", "type": 301 },
        { "source": "/asksight", "destination": "https://asksight.kiruu.xyz/", "type": 301 },
        { "source": "/asksight/:path*", "destination": "https://asksight.kiruu.xyz/:path", "type": 301 },
        { "source": "/anime", "destination": "https://anime.kiruu.xyz/", "type": 301 },
        { "source": "/anime/:path*", "destination": "https://anime.kiruu.xyz/:path", "type": 301 },
